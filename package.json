{
  "name": "digvation-company-profile",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "predev": "node --import tsx scripts/prepare-content.ts",
    "validate:content": "node --import tsx scripts/prepare-content.ts --validate-only",
    "typecheck": "tsc --noEmit",
    "build": "node --import tsx scripts/prepare-content.ts && tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir .server && node --import tsx scripts/prerender.ts && node --import tsx scripts/verify-build.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "npm run typecheck",
    "format": "prettier --write .",
    "lint": "eslint .",
    "qa": "npm run lint && npm run check && npm run test && npm run build",
    "format:check": "prettier --check .",
    "preview:pages": "npx wrangler pages dev dist",
    "content:publish": "node --import tsx scripts/publish-content.ts",
    "precheck": "node --import tsx scripts/prepare-content.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "9.34.0",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.41.0",
    "vite": "^7.2.0",
    "vitest": "^3.2.7"
  }
}
