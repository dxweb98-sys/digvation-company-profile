# =========================================================
# Cloudflare Pages Function: inquiry delivery
# Configure these as Cloudflare Variables / Secrets.
# =========================================================
INQUIRY_PROVIDER=resend
# CI/E2E only. Keep false in production.
INQUIRY_DRY_RUN=false
INQUIRY_RECIPIENT=hello@digvation.id
INQUIRY_FROM=Digvation <website@digvation.id>
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_TOKEN=
RESEND_API_KEY=

# Cloudflare Turnstile. Recommended for production inquiry protection.
TURNSTILE_MODE=turnstile
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=digvation.id,www.digvation.id
PUBLIC_TURNSTILE_SITEKEY=

# Public WhatsApp destination in international numeric format, without + or spaces.
# Leave empty until the approved Digvation number is available.
PUBLIC_WHATSAPP_NUMBER=

# =========================================================
# Visitor measurement / campaign measurement
# Public IDs are safe to expose in the built website.
# Recommended production mode: consent.
# =========================================================
PUBLIC_ANALYTICS_MODE=consent

# Direct GA4 measurement. Example: G-XXXXXXXXXX
PUBLIC_GA_ID=

# Google Tag Manager is used as the marketing-tag entry point.
# Put Google Ads / Meta Pixel / future campaign tags in GTM so they
# can be changed later without another website deployment.
# Example: GTM-XXXXXXX
PUBLIC_GTM_ID=

# Microsoft Clarity project ID (optional).
PUBLIC_CLARITY_ID=

# Optional HTML verification token. For Digvation, DNS verification
# through the Cloudflare-managed domain is preferred for Search Console.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# JSON content. Empty means use the checked-in content/ files.
# A release manifest allows atomic updates without changing this URL.
CONTENT_BASE_URL=
SITE_URL=https://digvation.id
CONTACT_ENDPOINT=/api/inquiry
META_PIXEL_ID=

# Maintainer-only R2 publishing (not bundled in the website).
R2_ACCOUNT_ID=
R2_CONTENT_BUCKET=
R2_CONTENT_PREFIX=content/development
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Create this hook specifically for development. Treat it as a secret.
DEVELOPMENT_DEPLOY_HOOK_URL=
